{
  "ConnectionStrings": {
    "Kanban": "Data Source=App_Data/kanban.db"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost"
}
